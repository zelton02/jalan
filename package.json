{
  "name": "jalan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tokens": "node ../keystone/packages/tokens/build.mjs --theme design/theme.json --out src/styles/tokens.css",
    "audit": "node ../keystone/packages/lint/audit.mjs src",
    "ingest": "node --no-warnings ingest/ingest.mjs",
    "next": "node --no-warnings ingest/next.mjs",
    "door": "node --no-warnings ingest/door.mjs",
    "route": "node --no-warnings ingest/route.mjs",
    "patterns": "node --no-warnings ingest/patterns.mjs",
    "live": "node --no-warnings ingest/live.mjs",
    "board": "node --no-warnings ingest/board.mjs",
    "punctual": "node --no-warnings ingest/punctuality.mjs",
    "deploy": "npm run build && rsync -a --delete dist/ /var/www/jalan/",
    "walk:build": "bash scripts/build-walk.sh",
    "ui:smoke": "node --no-warnings scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "gtfs-realtime-bindings": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
